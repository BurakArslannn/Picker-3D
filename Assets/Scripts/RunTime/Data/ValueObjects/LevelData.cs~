using System;
using System.Collections.Generic;
using RunTime.Enums;

namespace RunTime.Data.ValueObjects
{
    [Serializable]
    public struct LevelData
    {
        public List<PoolData> PoolList;
        public List<LevelObjectData> ObjectList;
        public List<CoinData> CoinDatas;

        public LevelData(List<PoolData> datas, List<LevelObjectData> objects, List<CoinData> coinDatas)
        {
            PoolList = datas;
            ObjectList = objects;
            CoinDatas = coinDatas;
        }
    }

    [Serializable]
    public struct PoolData
    {
        public byte requiredObjectCount;
    }

    [Serializable]
    public struct LevelObjectData
    {
        public byte totalObjectCount;
    }

    [Serializable]
    public struct CoinData
    {
        public byte levelID;
        public CoinType coinType;
        public int coinValue;
    }
}